# Salin ke .env.local (lokal) dan isi juga di Vercel → Settings → Environment Variables.
# Semua nilai ini RAHASIA — jangan di-commit.

# Google Calendar (lihat README)
GOOGLE_CALENDAR_GAS_ENDPOINT=

# GAS Kontrak Kerja — sumber daftar fungsio (sheet Respondents)
KONTRAK_GAS_URL=https://script.google.com/macros/s/XXXX/exec
# = nilai API_KEY di sheet Config Kontrak Kerja
KONTRAK_API_KEY=

# GAS Surat Keluar
SURAT_KELUAR_GAS_URL=https://script.google.com/macros/s/XXXX/exec
# = nilai apiKey di sheet Config Surat Keluar
SURAT_KELUAR_API_KEY=

# GAS Komitmen Iuran (Studi Ekskursi × Internalisasi)
KOMITMEN_GAS_URL=https://script.google.com/macros/s/XXXX/exec
# = nilai API_KEY di sheet Config Komitmen
KOMITMEN_API_KEY=
